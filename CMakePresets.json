{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SWGTK_INSTALL_FREETYPE": "ON",
        "SWGTK_BUILD_TESTS": false,
        "SWGTK_BUILD_EXAMPLES":false,
        "SWGTK_LUA_BINDINGS": false,
        "SWGTK_NO_CCACHE": false,
        "SWGTK_EXCEPTIONS": false,
        "SWGTK_CCACHE": "ccache",
        "SWGTK_CLANG_TIDY": "clang-tidy",
        "SWGTK_CPPCHECK": "cppcheck",
        "SWGTK_ROOT_DIRECTORY": "${sourceDir}/SWGTK",
        "SWGTK_ENGINE_INTERNALS": "${sourceDir}/SWGTK/engine/include/swgtk/internal"
      },
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "12"
      }
    },
    {
      "name": "msvc",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "SWGTK_INSTALL_FREETYPE": "OFF",
        "SWGTK_BUILD_TESTS": true,
        "SWGTK_BUILD_EXAMPLES":true,
        "SWGTK_LUA_BINDINGS": true
      },
      "environment": {
        "MSVC_IDE": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "enableClangTidyCodeAnalysis": true,
          "enableMicrosoftCodeAnalysis": true
        }
      }
    },
    {
      "name": "emscripten-debug",
      "inherits": "base",
      "displayName": "Emscripten Debug",
      "toolchainFile": "$penv{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "$penv{EMSDK}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWGTK_NO_CCACHE": true,
        "SWGTK_BUILD_EXAMPLES":true,
        "CMAKE_CXX_COMPILER": "em++",
        "CMAKE_C_COMPILER": "emcc",
        "CMAKE_EXECUTABLE_SUFFIX": ".html",
        "SDL_STATIC": "ON"
      }
    },
    {
      "name": "emscripten-release",
      "inherits": "emscripten-debug",
      "displayName": "Emscripten Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$penv{EMSDK}",
        "rhs": ""
      }
    },
    {
      "name": "desktop-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "SWGTK_BUILD_TESTS": true,
        "SWGTK_BUILD_EXAMPLES":true,
        "SWGTK_LUA_BINDINGS": true,
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Win64 Debug",
      "inherits": "desktop-base",
      "installDir": "${sourceDir}\\install\\${presetName}",
      "binaryDir": "${sourceDir}\\build\\${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-release",
      "displayName": "Win64 Release",
      "inherits": "win-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "desktop-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    }
  ]
}
